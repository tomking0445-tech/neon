# Railway가 Postgres 플러그인을 추가하면 자동으로 주입해줍니다.
# 로컬 개발 시에만 직접 채워서 .env로 복사해 사용하세요.
DATABASE_URL="postgresql://user:password@localhost:5432/neon"

# 최소 32자 이상의 임의의 랜덤 문자열로 교체하세요. (예: `openssl rand -hex 32`)
JWT_SECRET="replace-with-a-long-random-secret"

# 프론트엔드(퍼블리시한 Artifact) 도메인. 쉼표로 여러 개 지정 가능.
# 정확한 도메인을 모르면 우선 "*" 로 두고, 확정되면 좁혀서 배포하세요.
ALLOWED_ORIGINS="*"

# Railway가 자동으로 PORT를 주입합니다. 로컬 테스트용 기본값.
PORT=4000
